# reelocations — configuration. Copy to .env (never commit .env). Every value here is optional for local development
# and tests: `npm test` and `npm run demo` run with no .env at all. Values are read by src/config.ts, src/server.ts
# and src/cli.ts.

# ======================= Hosted server (src/server.ts — Railway in production) =======================
# REQUIRED for the server: a random secret (≥16 chars) for the admin API (backup/import/run). Not used by the website.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
APP_TOKEN=
# Google Sign-In (OAuth client ID of type "Web application", Authorized JavaScript origin = your site). Without it the
# sign-in page explains that sign-in is not configured.
GOOGLE_OAUTH_CLIENT_ID=
# Public base URL, used in invitation links and the Shortcut intake link (default: taken from the request).
PUBLIC_URL=
# Where the SQLite database and media live (default ./data). Railway: /data (a mounted volume).
REEL_MAPS_DATA_DIR=
PORT=8080
# Seconds between processing cycles (a share also starts one immediately).
WORKER_INTERVAL_SEC=60
# 1 = do not process anything until a one-time data import has run (migration from a desktop install).
WAIT_FOR_IMPORT=

# Google Maps list publisher on the server (beta): saves verified listings to a list in a Google account whose browser
# session was connected with `npm run cli -- gmaps-connect`. Needs Chromium (CHROME_PATH; included in the Docker image).
# off = never open the browser. The session itself is stored under <data>/private/gmaps/, never in this file.
GMAPS_LIST_SYNC=on

# ======================= Desktop publisher (src/cli.ts publish / run) =======================
# Written by `npm run cli -- connect <HOSTED_URL> <code>` — you normally do not type these.
HOSTED_URL=
PUBLISHER_TOKEN=
# sync-only = the scheduled task only publishes finished pins to Google My Maps (the server does all processing).
WORKER_MODE=sync-only
# Google My Maps: one map per country (default) or the legacy single layer.
MYMAPS_GROUPING=country
# Real "Reels · <country>" maps are written only when true. Rehearse first: npm run cli -- publish --test-map
MYMAPS_REAL_SYNC=false
MYMAPS_TITLE_PREFIX=Reels ·
# Legacy single-map mode only:
MYMAPS_MAP_ID=
MYMAPS_LAYER_NAME=Reels (auto)
MYMAPS_LAYOUT=one-map
MYMAPS_MAP_TITLE=Reels
# Disposable map used only by `npm run google:verify`
MYMAPS_TEST_MAP_ID=
# Optional: path to chrome.exe if it is not in the default location (the publisher drives your installed Chrome).
CHROME_PATH=

# ======================= Place lookup =======================
# Identify the app to OpenStreetMap services (Nominatim policy). No email needed.
USER_AGENT=reelocations/0.2 (personal tool)
NOMINATIM_URL=https://nominatim.openstreetmap.org
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
# Optional Google Places (New) Text Search — exact listings and branches. Needs a billing-enabled key; the app
# stays within a monthly call cap. Empty = OpenStreetMap only.
GOOGLE_PLACES_API_KEY=

# ======================= Reel text =======================
# Meta oEmbed: keep false. Meta allows oEmbed data only for displaying an embed, not for reading/storing the caption.
INSTAGRAM_OEMBED=false
# Opt-in: read the caption a logged-out visitor sees on the public Reel page (headless Chromium).
INSTAGRAM_PAGE_CAPTION=false

# ======================= Media fallback (local, free) =======================
OCR_LANGS=eng
# auto = local Whisper if the optional package is installed (npm i @huggingface/transformers); off = never.
TRANSCRIBE=auto
TRANSCRIBE_LANGUAGE=
# Where downloaded speech models are cached (Railway: /data/models).
HF_HOME=

# ======================= Paid AI fallback (optional; hard cap US$3/month in total) =======================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_MONTHLY_BUDGET_USD=3
OPENAI_MAX_FRAMES=8
OPENAI_IMAGE_DETAIL=high
OPENAI_DAILY_CALLS=30
# Legacy Claude vision fallback (suggestions only; off unless both are set)
ANTHROPIC_API_KEY=
VISION_MODEL=claude-haiku-5-5
VISION_MONTHLY_BUDGET_USD=0

# ======================= Legacy intake (Google Apps Script inbox; see docs/legacy-apps-script.md) =======================
# The original Shortcut endpoint (https://script.google.com/macros/s/<deployment id>/exec) and its token. Still
# accepted by the server for collection 1; new installs use the personal intake link from Setup instead.
INBOX_URL=
INBOX_TOKEN=
# Local review UI of the legacy desktop worker (npm run serve)
REVIEW_PORT=8787
